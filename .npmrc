# Don't re-run an install check before every `pnpm --filter ... run` — it trips
# on editor-injected workspace keys and isn't needed in CI/containers.
verify-deps-before-run=false
# Native build scripts (esbuild/keccak/ws) are optional here; platform binaries
# come from optional deps, so a skipped postinstall is not fatal.
strict-dep-builds=false
