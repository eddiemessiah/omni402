{
  "name": "@omni402/video",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic demo video for Omni402, rendered with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Omni402Demo out/omni402-demo.mp4 --codec=h264",
    "still": "remotion still src/index.ts Omni402Demo out/thumbnail.png --frame=30"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.230",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.230"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
