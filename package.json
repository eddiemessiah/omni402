{
  "name": "x402-alpha",
  "version": "0.1.0",
  "private": true,
  "description": "Convert any HTTP API into an x402 pay-per-call endpoint, settled in stablecoins on Celo.",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @omni402/dashboard build",
    "start": "node --env-file-if-exists=.env --import tsx apps/hub/src/serve.ts",
    "hub": "node --env-file-if-exists=.env --import tsx apps/hub/src/serve.ts",
    "wrap": "node --env-file-if-exists=.env --import tsx packages/x402ify/bin/x402ify.ts",
    "supported": "node --env-file-if-exists=.env --import tsx packages/config/src/probe.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx apps/mcp/src/server.ts",
    "agent": "node --env-file-if-exists=.env --import tsx apps/mcp/src/agent.ts",
    "register-8004": "node --env-file-if-exists=.env --import tsx packages/x402ify/bin/register-8004.ts",
    "test": "node --import tsx packages/x402ify/test/challenge.smoke.ts && node --import tsx packages/x402ify/test/mpp.smoke.ts && node --import tsx packages/x402ify/test/buyer.smoke.ts && node --import tsx apps/mcp/test/mcp.smoke.ts",
    "typecheck": "tsc -b --pretty"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "keccak", "bufferutil", "utf-8-validate"]
  }
}
