# ─────────────────────────────────────────────────────────────
#  x402-alpha / Omni402 — environment
#  Copy to .env and fill in.  cp .env.example .env && chmod 600 .env
#  NEVER commit .env. It is gitignored.
# ─────────────────────────────────────────────────────────────

# Where payments settle: "celo" (mainnet) or "celo-sepolia" (testnet).
# Start on testnet; flip to celo for the live mainnet test.
X402_NETWORK=celo

# ── Seller (required for LIVE settlement) ─────────────────────
# The wallet that RECEIVES the USDC. Your own EVM address.
# No private key on the server — buyers sign, the facilitator settles.
SELLER_PAY_TO=0xYourReceivingWallet

# MPP server secret — signs/verifies challenges & receipts. >= 32 bytes.
#   Generate:  openssl rand -base64 32
MPP_SECRET_KEY=

# Facilitator credits key. Get it at https://x402.celo.org
#   (connect an EVM wallet → Create API key → copy the x402_... value).
#   New accounts start with free testnet + mainnet credits.
X402_API_KEY=

# ── Upstream API keys (per lane in lanes.json) ────────────────
# The key never leaves this machine; the gateway injects it only after
# a payment settles. Add the ones your lanes reference.
# ETHERSCAN_KEY=
# ALPHAVANTAGE_KEY=

# ── Hub / dashboard ───────────────────────────────────────────
HUB_PORT=4021
# Public base URL the hub is reachable at (used by the MCP catalog to build
# payable /pay/<slug> URLs). On a host, set this to your public domain.
PUBLIC_BASE=http://localhost:4021

# ── Advanced (optional) ───────────────────────────────────────
# CELO_RPC_URL=https://forno.celo.org
# CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# X402_FACILITATOR_URL=https://x402.celo.org           # x402-rs fallback path
# CELO_SEPOLIA_USDC_ADDRESS=                            # override if Celo rotates it

# ── Buyer (only for the test client / MCP, NOT the server) ────
# A throwaway wallet with a little USDC and NO native CELO.
#   Fund testnet USDC: https://faucet.circle.com (select Celo Sepolia)
# NEVER put a wallet with real funds here.
# BUYER_PRIVATE_KEY=
